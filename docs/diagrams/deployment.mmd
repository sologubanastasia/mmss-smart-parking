---
title: Подання розгортання — система розумної парковки
config:
  layout: elk
---
flowchart LR
    subgraph Field["Польові пристрої (територія парковки)"]
        cams["IP Cameras ×50<br/>1080p15 3 Мбіт/с + 360p5 0,5 Мбіт/с"]
        lprcams["LPR Cameras ×2<br/>1080p25, 4 Мбіт/с"]
        sensors["Ultrasonic Sensors ×500"]
        sensorctl["Sensor Controllers ×50<br/>по 10 датчиків"]
        gate["Gate Controller ×2<br/>безпечний стан: закрито"]
        board["Information Board ×6"]
    end

    subgraph EdgeNode["Edge Node — технічне приміщення парковки<br/>16 CPU, GPU, 64 ГБ ОЗП"]
        video["Video Analytics (GPU)"]
        lpr["LPR Service (GPU)"]
        tbroker["Telemetry Broker"]
        ingest["Sensor Ingest"]
        sync["Time Synchronizer<br/>NTP-сервер"]
        fusion["Occupancy Fusion"]
        edgeAccess["Edge Access Control"]
        cbroker["Control Broker"]
        eventBuffer[("Local Event Buffer<br/>SSD 256 ГБ")]
        videoBuffer[("Local Video Buffer<br/>SSD 2 ТБ, шифрування, 12 год")]
        syncAgent["Sync Agent<br/>ліміт 60 Мбіт/с"]
        localMetrics["Local Metrics"]
    end

    subgraph Server["Серверний сегмент (дата-центр)"]
        lb["Reverse Proxy / Load Balancer"]
        subgraph ApiNodes["API Nodes ×2"]
            api1["Parking API instance 1"]
            api2["Parking API instance 2"]
        end
        subgraph AppNode["App Node"]
            access["Access Service"]
            sessions["Session Service"]
            guidance["Guidance Service"]
            devices["Device Registry"]
            paymentAdapter["Payment Adapter"]
        end
        db[("Metadata DB<br/>Data Node")]
        media[("Event Media Storage<br/>об'єктне сховище, 10 ТБ")]
        subgraph OpsNode["Ops Node"]
            obs["Observability"]
            audit[("Audit Log")]
        end
    end

    subgraph Clients["Клієнтські пристрої"]
        app["Driver App<br/>смартфон"]
        console["Web Console<br/>ПК персоналу на парковці"]
    end

    subgraph External["Зовнішні системи"]
        paymentService["Payment Service"]
        notify["Notification Service"]
    end

    cams -->|"RTSP, VLAN відео 1 Гбіт/с: 25 Мбіт/с"| video
    cams -->|"RTSP, VLAN відео: 150 Мбіт/с"| videoBuffer
    lprcams -->|"RTSP, VLAN відео: 8 Мбіт/с"| lpr
    sensors -->|"RS-485, 10 Гц"| sensorctl
    sensorctl -->|"MQTT QoS 1 + TLS, VLAN керування"| tbroker
    tbroker -->|"MQTT, лічильники зон"| board
    cbroker -->|"MQTT QoS 1 + TLS, VLAN керування"| gate
    gate -->|"підтвердження"| cbroker
    sync -.->|"NTP, похибка ≤ 10 мс"| cams
    sync -.->|"NTP"| sensorctl

    syncAgent <-->|"HTTPS / TLS 1.3, WAN 100 Мбіт/с:<br/>події й фрагменти ↑, політики доступу ↓"| lb
    localMetrics -.->|"HTTPS, WAN: метрики, heartbeat"| obs
    console -->|"HTTPS, LAN парковки: ручне керування"| edgeAccess

    lb -->|"події, запити клієнтів"| api1
    lb -->|"події, запити клієнтів"| api2
    lb -->|"фрагменти"| media
    ApiNodes -->|"gRPC / TLS"| AppNode
    ApiNodes -->|"SQL / TLS"| db
    AppNode -->|"SQL / TLS"| db
    ApiNodes -->|"S3 API / TLS"| media
    ApiNodes -->|"записи доступу"| audit
    AppNode -->|"записи аудиту"| audit

    app <-->|"HTTPS / WSS, інтернет"| lb
    console <-->|"HTTPS / WSS, WAN"| lb
    paymentAdapter <-->|"HTTPS, ідемпотентні запити"| paymentService
    sessions -->|"HTTPS"| notify
    obs -->|"HTTPS"| notify

